### Django ###
DJANGO_SECRET_KEY=cambiame_por_un_string_largo_y_aleatorio
DJANGO_DEBUG=True
# Incluí el host del túnel (ej. siempregym.tudominio.com) si accedés vía cloudflared.
DJANGO_ALLOWED_HOSTS=localhost 127.0.0.1 [::1]
# URL pública HTTPS del túnel; activa CSRF y proxy SSL en settings.py.
# PUBLIC_WEBHOOK_BASE_URL=https://siempregym.tudominio.com

### POSTGRESQL ###
POSTGRES_USER=gymflow
POSTGRES_PASSWORD=gymflow
POSTGRES_DB=gymflow
POSTGRES_PORT=5432
# Variable POSTGRES_HOST
# Usa 'localhost' para correr Django localmente
# El archivo docker-compose sobrescribe la variable al hostname
# del contenedor de la bd, no hace falta modificarlo.
POSTGRES_HOST=localhost

### EMAIL ###
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Siempre GYM <noreply@siempregym.com>

### Mercadopago ###
MERCADO_PAGO_PUBLIC_KEY=APP_USR-XXX
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-XXXXXX
PUBLIC_WEBHOOK_BASE_URL=
MERCADO_PAGO_WEBHOOK_SECRET=